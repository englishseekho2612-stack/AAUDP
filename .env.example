# =============================================================================
# AI TEACHING STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env for local development or configure these variables
# in your cloud hosting provider secrets manager (e.g. Google Cloud Run / AI Studio).
# NEVER commit real credentials or .env to version control.

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV="development"

# The publicly accessible origin URL of this deployment (without trailing slash).
# In AI Studio, this is automatically injected with the container Cloud Run URL.
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 2. GEMINI AI ENGINE (Part 03, 04, 06)
# -----------------------------------------------------------------------------
# Required for server-side Mind Map, Presentation, Notes, Quiz, and Audio/Video AI.
# Stored securely server-side; NEVER sent to client browsers.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# -----------------------------------------------------------------------------
# 3. YOUTUBE LIVE & GOOGLE OAUTH (Part 05)
# -----------------------------------------------------------------------------
# Required for authenticating with YouTube Data API v3 to create broadcasts.
# Create credentials in Google Cloud Console > APIs & Services > Credentials:
# - Authorized redirect URI: ${APP_URL}/auth/youtube/callback
YOUTUBE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your_google_oauth_client_secret"

# -----------------------------------------------------------------------------
# 4. FIREBASE / CLOUD FIRESTORE (Optional remote classroom sync)
# -----------------------------------------------------------------------------
# When omitted, the studio operates using zero-cloud local IndexedDB storage
# and self-contained server-side SSE event streaming.
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_API_KEY="your_firebase_api_key"
FIREBASE_AUTH_DOMAIN="your_firebase_project.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="your_firebase_project.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
FIREBASE_APP_ID="your_firebase_app_id"

