{
  "name": "arpit-academy-udaipura",
  "productName": "Arpit Academy Udaipura",
  "private": true,
  "version": "1.0.0",
  "author": "Arpit Digital Hub",
  "description": "Arpit Academy Udaipura - Learn • Understand • Visualize • Teach. With Arpit Sir.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist/server.cjs dist_electron",
    "lint": "tsc --noEmit",
    "electron:dev": "ELECTRON_DEV=true electron electron/main.cjs",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:pack": "electron-builder --dir",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "android:prepare": "node scripts/prepare-android.js",
    "android:sync": "npm run build && node scripts/prepare-android.js"
  },
  "build": {
    "appId": "com.arpitdigitalhub.arpitacademyudaipura",
    "productName": "Arpit Academy Udaipura",
    "copyright": "Copyright © 2026 Arpit Digital Hub",
    "directories": {
      "output": "dist_electron",
      "buildResources": "electron/assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico",
      "artifactName": "ArpitAcademyUdaipura-Setup.${ext}",
      "publisherName": "Arpit Digital Hub"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Arpit Academy Udaipura",
      "uninstallDisplayName": "Arpit Academy Udaipura",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.2",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
